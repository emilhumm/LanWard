# LanWard settings. Copy to .env next to docker-compose.yml if you need it:
# everything is optional, and LanWard runs without a .env. Most of these can
# be changed on the dashboard's Settings page instead, which wins over this
# file. After a change here: docker compose up -d

# ── Dashboard
# Port on this machine (host networking).
DASHBOARD_PORT=8080
# Dashboard login. Empty: a fresh install logs in with the default password
# "lanward" and nags you to change it on the Settings page (where you set your
# own, turn the login off, or set an idle auto-logout). "off": no login, anyone
# on your network can use it. Any other value here is the password.
DASHBOARD_PASSWORD=

# ── Alerts out (none, one or more; also on the Settings page)
# Every alert POSTed as JSON to these URLs, separated by spaces: Home Assistant
# (a webhook trigger), Node-RED, n8n... The JSON: severity, kind, title, message,
# time, url.
WEBHOOK_URLS=
# A message straight to your phone or inbox, no other system needed: Apprise
# addresses separated by spaces, e.g. ntfy://my-lanward-topic,
# tgram://bot-token/chat-id, pover://user@token, mailtos://user:pass@gmail.com
# (all services: https://github.com/caronc/apprise/wiki).
NOTIFY_URLS=
# Lowest severity that is sent: info | warning | alert
NOTIFY_MIN_SEVERITY=warning
# Test them: Settings page, Send a test alert (or docker exec lanward python3 common.py test-push)

# ── Reading LanWard's data (GET /api/status, /api/devices, /api/alerts)
# With the API key from the Settings page (Authorization: Bearer <key>), or without
# one from these addresses (comma list), e.g. Home Assistant's: 127.0.0.1,192.168.1.20
STATUS_ALLOW=127.0.0.1

# ── The network (found by itself; set only if that goes wrong)
# Interface to listen and scan on, and the LAN to scan.
IFACE=
SUBNET=
# Where alert links point, e.g. http://192.168.1.50:8080
DASHBOARD_URL=

# ── Scans, watching, keeping (all but LEARN_HOURS also on the Settings page)
# Hours (0-23) at which the security scan runs. Empty: no scheduled scans (Run
# scan on the dashboard); values that are not an hour are logged and ignored.
SCAN_HOURS=0,6,12,18
# Minutes a watched device may be silent before "offline" is sent.
WATCH_OFFLINE_MINUTES=10
# On a fresh install: hours of learning what is already at home before new
# devices raise alerts. 0: alert from the start.
LEARN_HOURS=24
# DHCP servers besides the router that are meant to be there (Pi-hole, AdGuard
# Home): comma-separated MACs. Any other one raises "A second DHCP server".
DHCP_SERVERS_OK=
# Days of scan history kept by the Sunday clean-up. The newest scan always stays.
RETAIN_SCAN_DAYS=365
# Days of nightly backups kept in data/backups. 0: no backups.
BACKUP_KEEP_DAYS=14
# Time zone, only if the host's is not the one you want (an empty TZ= means UTC):
# TZ=Europe/Berlin

# ── Where things are (docker-compose.yml)
# The code to run (default: the folder docker-compose.yml is in) and the data folder.
LANWARD_CODE=
LANWARD_DATA_DIR=

# tshark recycle limits (passive monitor memory).
TSHARK_MAX_AGE_HOURS=24
TSHARK_MAX_RSS_MB=400
